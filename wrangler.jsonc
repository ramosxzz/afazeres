{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afazeres",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Front-end (build do Vite) servido como assets estáticos.
  // /api/* cai no Worker; qualquer outra rota volta pro index.html (SPA).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Banco D1 (afazeres-db, região ENAM — a mais próxima do Brasil).
  // As tabelas são criadas/migradas automaticamente pelo próprio Worker.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afazeres-db",
      "database_id": "268e406b-de74-4ea7-9d34-a44bf8fd2fde"
    }
  ]

  // Segredos (NÃO coloque aqui — use o painel ou `wrangler secret put`):
  //   APP_PASSWORD  → senha para entrar no app
}
